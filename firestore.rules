rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && isEmailVerified()
        && request.auth.token.email == 'dancerohmrobin@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isSignedIn() && isEmailVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(ownerUid) {
      return isSignedIn() && isEmailVerified() && request.auth.uid == ownerUid;
    }

    function isWorkerSelf(data) {
      return isSignedIn()
        && isEmailVerified()
        && 'workerUid' in data
        && data.workerUid is string
        && data.workerUid != ''
        && request.auth.uid == data.workerUid;
    }

    // 3. Validation Blueprints
    function isValidReasons(reasons) {
      return reasons is list
        && reasons.size() >= 1
        && reasons.size() <= 10
        && reasons[0] is string
        && reasons[0].size() >= 1
        && reasons[0].size() <= 160;
    }

    function isValidConditionsMap(cond) {
      return cond is map
        && cond.keys().hasAll(['hypertension', 'diabetes', 'priorHeat'])
        && cond.keys().hasOnly(['hypertension', 'diabetes', 'priorHeat'])
        && cond.hypertension is bool
        && cond.diabetes is bool
        && cond.priorHeat is bool;
    }

    function isValidReadinessMap(readiness) {
      return readiness is map
        && readiness.keys().hasAll(['lowSleep', 'sedatingMeds', 'dizzyOrUnwell'])
        && readiness.keys().hasOnly(['lowSleep', 'sedatingMeds', 'dizzyOrUnwell'])
        && readiness.lowSleep is bool
        && readiness.sedatingMeds is bool
        && readiness.dizzyOrUnwell is bool;
    }

    function isValidOptionalIsoTimestamp(ts) {
      return ts == null || (ts is string && ts.size() >= 10 && ts.size() <= 40);
    }

    function isValidReportSnapshot(rep) {
      return rep is map
        && rep.keys().hasAll([
          'id', 'workerId', 'bandId', 'bpm', 'spo2', 'skinTempC',
          'minutesSinceBreak', 'condition', 'reasons', 'source', 'timestamp'
        ])
        && rep.keys().hasOnly([
          'id', 'workerId', 'bandId', 'bpm', 'spo2', 'skinTempC',
          'hrvMs', 'heatIndexC', 'perfusionIndex', 'batteryPct',
          'tremorHz', 'hrrBpmDrop', 'shiftHours', 'leadOff', 'mq3Flag',
          'minutesSinceBreak', 'condition', 'reasons', 'source', 'timestamp'
        ])
        && isValidId(rep.id)
        && isValidId(rep.workerId)
        && rep.bandId is string && rep.bandId.size() >= 1 && rep.bandId.size() <= 48 && rep.bandId.matches('^[a-zA-Z0-9_\\-]+$')
        && rep.bpm is number && rep.bpm >= 25 && rep.bpm <= 240
        && rep.spo2 is number && rep.spo2 >= 50 && rep.spo2 <= 100
        && rep.skinTempC is number && rep.skinTempC >= 25 && rep.skinTempC <= 45
        && (!('hrvMs' in rep) || rep.hrvMs == null || (rep.hrvMs is number && rep.hrvMs >= 0 && rep.hrvMs <= 300))
        && (!('heatIndexC' in rep) || rep.heatIndexC == null || (rep.heatIndexC is number && rep.heatIndexC >= -20 && rep.heatIndexC <= 75))
        && (!('perfusionIndex' in rep) || rep.perfusionIndex == null || (rep.perfusionIndex is number && rep.perfusionIndex >= 0 && rep.perfusionIndex <= 25))
        && (!('batteryPct' in rep) || rep.batteryPct == null || (rep.batteryPct is number && rep.batteryPct >= 0 && rep.batteryPct <= 100))
        && (!('tremorHz' in rep) || rep.tremorHz == null || (rep.tremorHz is number && rep.tremorHz >= 0 && rep.tremorHz <= 30))
        && (!('hrrBpmDrop' in rep) || rep.hrrBpmDrop == null || (rep.hrrBpmDrop is number && rep.hrrBpmDrop >= 0 && rep.hrrBpmDrop <= 80))
        && (!('shiftHours' in rep) || rep.shiftHours == null || (rep.shiftHours is number && rep.shiftHours >= 0 && rep.shiftHours <= 24))
        && (!('leadOff' in rep) || rep.leadOff is bool)
        && (!('mq3Flag' in rep) || rep.mq3Flag is bool)
        && rep.minutesSinceBreak is number && rep.minutesSinceBreak >= 0 && rep.minutesSinceBreak <= 1440
        && rep.condition in ['normal', 'caution', 'critical']
        && isValidReasons(rep.reasons)
        && rep.source in ['ble', 'api', 'manual']
        && rep.timestamp is string && rep.timestamp.size() >= 10 && rep.timestamp.size() <= 40;
    }

    function isValidWorker(data) {
      return data.keys().hasAll([
        'id', 'name', 'role', 'bandId', 'baselineHr', 'loadFactor',
        'condition', 'reasons', 'lastReport', 'ownerUid', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'name', 'role', 'bandId', 'baselineHr', 'loadFactor',
        'age', 'conditions', 'restingBp', 'mountMode',
        'daysOnSite', 'dutyZone', 'readiness', 'gaitBalance', 'fitStatus', 'fitReasons',
        'mq3Status', 'mq3MgL', 'mq3CheckedAt',
        'shiftHours', 'shiftStartHr', 'lastKeepAliveAt', 'leadOff',
        'riskFactor', 'dynamicHrY', 'dynamicHrR',
        'mentalStrainLevel', 'mentalRfBoost', 'mentalAdjustedAt', 'workerUid',
        'condition', 'reasons', 'lastReport', 'ownerUid', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
      && data.role is string && data.role.size() >= 1 && data.role.size() <= 60
      && data.bandId is string && data.bandId.size() <= 48 && (data.bandId == '' || data.bandId.matches('^[a-zA-Z0-9_\\-]+$'))
      && data.baselineHr is number && data.baselineHr >= 40 && data.baselineHr <= 140
      && data.loadFactor is number && data.loadFactor >= 0.1 && data.loadFactor <= 2.0
      && (!('age' in data) || (data.age is number && data.age >= 18 && data.age <= 85))
      && (!('conditions' in data) || isValidConditionsMap(data.conditions))
      && (!('restingBp' in data) || (data.restingBp is string && data.restingBp.size() >= 3 && data.restingBp.size() <= 16 && data.restingBp.matches('^[0-9]{2,3}/[0-9]{2,3}$')))
      && (!('mountMode' in data) || (data.mountMode is string && data.mountMode.size() >= 5 && data.mountMode.size() <= 16 && data.mountMode in ['wrist', 'bicep', 'helmet']))
      && (!('daysOnSite' in data) || (data.daysOnSite is number && data.daysOnSite >= 1 && data.daysOnSite <= 3650))
      && (!('dutyZone' in data) || (data.dutyZone is string && data.dutyZone.size() >= 6 && data.dutyZone.size() <= 16 && data.dutyZone in ['height', 'heavy_sun', 'shaded']))
      && (!('readiness' in data) || isValidReadinessMap(data.readiness))
      && (!('gaitBalance' in data) || (data.gaitBalance is string && data.gaitBalance.size() >= 4 && data.gaitBalance.size() <= 16 && data.gaitBalance in ['pending', 'stable', 'sway']))
      && (!('fitStatus' in data) || (data.fitStatus is string && data.fitStatus.size() >= 8 && data.fitStatus.size() <= 16 && data.fitStatus in ['fit_full', 'shaded_only', 'medical_hold']))
      && (!('fitReasons' in data) || isValidReasons(data.fitReasons))
      && (!('mq3Status' in data) || (data.mq3Status is string && data.mq3Status.size() >= 5 && data.mq3Status.size() <= 16 && data.mq3Status in ['pending', 'clear', 'flagged']))
      && (!('mq3MgL' in data) || data.mq3MgL == null || (data.mq3MgL is number && data.mq3MgL >= 0 && data.mq3MgL <= 2.5))
      && (!('mq3CheckedAt' in data) || isValidOptionalIsoTimestamp(data.mq3CheckedAt))
      && (!('shiftHours' in data) || (data.shiftHours is number && data.shiftHours >= 0 && data.shiftHours <= 24))
      && (!('shiftStartHr' in data) || data.shiftStartHr == null || (data.shiftStartHr is number && data.shiftStartHr >= 30 && data.shiftStartHr <= 200))
      && (!('lastKeepAliveAt' in data) || isValidOptionalIsoTimestamp(data.lastKeepAliveAt))
      && (!('leadOff' in data) || data.leadOff is bool)
      && (!('riskFactor' in data) || (data.riskFactor is number && data.riskFactor >= 0.8 && data.riskFactor <= 2.5))
      && (!('dynamicHrY' in data) || (data.dynamicHrY is number && data.dynamicHrY >= 70 && data.dynamicHrY <= 160))
      && (!('dynamicHrR' in data) || (data.dynamicHrR is number && data.dynamicHrR >= 85 && data.dynamicHrR <= 180))
      && (!('mentalStrainLevel' in data) || (data.mentalStrainLevel is string && data.mentalStrainLevel in ['calm', 'mild', 'strained', 'rest_advised']))
      && (!('mentalRfBoost' in data) || (data.mentalRfBoost is number && data.mentalRfBoost >= 0 && data.mentalRfBoost <= 0.25))
      && (!('mentalAdjustedAt' in data) || isValidOptionalIsoTimestamp(data.mentalAdjustedAt))
      && (!('workerUid' in data) || data.workerUid == null || (data.workerUid is string && data.workerUid.size() <= 128))
      && data.condition in ['unlinked', 'normal', 'caution', 'critical']
      && isValidReasons(data.reasons)
      && (data.lastReport == null || isValidReportSnapshot(data.lastReport))
      && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidPrivateVault(data, uid) {
      return data.keys().hasAll(['workerUid', 'preferredLanguageCode', 'updatedAt'])
        && data.keys().hasOnly([
          'workerUid', 'workerId', 'preferredLanguageCode', 'preferredState',
          'lastMentalStrainLevel', 'lastMentalRfBoost', 'updatedAt'
        ])
        && data.workerUid == uid
        && (!('workerId' in data) || (data.workerId is string && data.workerId.size() <= 128))
        && data.preferredLanguageCode is string && data.preferredLanguageCode.size() >= 2 && data.preferredLanguageCode.size() <= 16
        && (!('preferredState' in data) || (data.preferredState is string && data.preferredState.size() >= 1 && data.preferredState.size() <= 64))
        && (!('lastMentalStrainLevel' in data) || (data.lastMentalStrainLevel is string && data.lastMentalStrainLevel in ['calm', 'mild', 'strained', 'rest_advised']))
        && (!('lastMentalRfBoost' in data) || (data.lastMentalRfBoost is number && data.lastMentalRfBoost >= 0 && data.lastMentalRfBoost <= 0.25))
        && data.updatedAt is timestamp;
    }

    function isValidPrivateCheckin(data, uid, checkinId) {
      return data.keys().hasAll([
          'id', 'workerUid', 'languageCode', 'languageName',
          'workerMessage', 'buddyReply', 'buddyMood',
          'mentalStrainLevel', 'mentalRfBoost', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'workerUid', 'workerId', 'languageCode', 'languageName',
          'workerMessage', 'buddyReply', 'buddyMood',
          'mentalStrainLevel', 'mentalRfBoost', 'gentleCareTip',
          'syncedToBand', 'createdAt'
        ])
        && isValidId(checkinId)
        && data.id == checkinId
        && data.workerUid == uid
        && (!('workerId' in data) || (data.workerId is string && data.workerId.size() <= 128))
        && data.languageCode is string && data.languageCode.size() >= 2 && data.languageCode.size() <= 16
        && data.languageName is string && data.languageName.size() >= 1 && data.languageName.size() <= 64
        && data.workerMessage is string && data.workerMessage.size() >= 1 && data.workerMessage.size() <= 2000
        && data.buddyReply is string && data.buddyReply.size() >= 1 && data.buddyReply.size() <= 2500
        && data.buddyMood in ['warm', 'listening', 'encouraging', 'caring', 'alert']
        && data.mentalStrainLevel in ['calm', 'mild', 'strained', 'rest_advised']
        && data.mentalRfBoost is number && data.mentalRfBoost >= 0 && data.mentalRfBoost <= 0.25
        && (!('gentleCareTip' in data) || (data.gentleCareTip is string && data.gentleCareTip.size() <= 400))
        && (!('syncedToBand' in data) || data.syncedToBand is bool)
        && data.createdAt is timestamp;
    }

    function isValidTelemetryReport(data, parentWorkerId) {
      return data.keys().hasAll([
        'id', 'workerId', 'bandId', 'bpm', 'spo2', 'skinTempC',
        'minutesSinceBreak', 'condition', 'reasons', 'source',
        'ownerUid', 'timestamp', 'createdAt'
      ])
      && data.keys().hasOnly([
        'id', 'workerId', 'bandId', 'bpm', 'spo2', 'skinTempC',
        'hrvMs', 'heatIndexC', 'perfusionIndex', 'batteryPct',
        'tremorHz', 'hrrBpmDrop', 'shiftHours', 'leadOff', 'mq3Flag',
        'minutesSinceBreak', 'condition', 'reasons', 'source',
        'ownerUid', 'timestamp', 'createdAt'
      ])
      && isValidId(data.id)
      && data.workerId == parentWorkerId
      && isValidId(data.workerId)
      && data.bandId is string && data.bandId.size() >= 1 && data.bandId.size() <= 48 && data.bandId.matches('^[a-zA-Z0-9_\\-]+$')
      && data.bpm is number && data.bpm >= 25 && data.bpm <= 240
      && data.spo2 is number && data.spo2 >= 50 && data.spo2 <= 100
      && data.skinTempC is number && data.skinTempC >= 25 && data.skinTempC <= 45
      && (!('hrvMs' in data) || data.hrvMs == null || (data.hrvMs is number && data.hrvMs >= 0 && data.hrvMs <= 300))
      && (!('heatIndexC' in data) || data.heatIndexC == null || (data.heatIndexC is number && data.heatIndexC >= -20 && data.heatIndexC <= 75))
      && (!('perfusionIndex' in data) || data.perfusionIndex == null || (data.perfusionIndex is number && data.perfusionIndex >= 0 && data.perfusionIndex <= 25))
      && (!('batteryPct' in data) || data.batteryPct == null || (data.batteryPct is number && data.batteryPct >= 0 && data.batteryPct <= 100))
      && (!('tremorHz' in data) || data.tremorHz == null || (data.tremorHz is number && data.tremorHz >= 0 && data.tremorHz <= 30))
      && (!('hrrBpmDrop' in data) || data.hrrBpmDrop == null || (data.hrrBpmDrop is number && data.hrrBpmDrop >= 0 && data.hrrBpmDrop <= 80))
      && (!('shiftHours' in data) || data.shiftHours == null || (data.shiftHours is number && data.shiftHours >= 0 && data.shiftHours <= 24))
      && (!('leadOff' in data) || data.leadOff is bool)
      && (!('mq3Flag' in data) || data.mq3Flag is bool)
      && data.minutesSinceBreak is number && data.minutesSinceBreak >= 0 && data.minutesSinceBreak <= 1440
      && data.condition in ['normal', 'caution', 'critical']
      && isValidReasons(data.reasons)
      && data.source in ['ble', 'api', 'manual']
      && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
      && data.timestamp is string && data.timestamp.size() >= 10 && data.timestamp.size() <= 40
      && data.createdAt is timestamp;
    }

    // 4. Collection Rules
    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn()
        && isEmailVerified()
        && isValidId(adminId)
        && (request.auth.uid == adminId || isBootstrappedAdmin());
      allow list, write: if false;
    }

    match /workers/{workerId} {
      allow get: if isSignedIn()
        && isEmailVerified()
        && isValidId(workerId)
        && (isAdmin() || ('ownerUid' in existing() && isOwner(existing().ownerUid)) || isWorkerSelf(existing()));

      allow list: if isSignedIn()
        && isEmailVerified()
        && (
          isAdmin()
          || resource.data.ownerUid == request.auth.uid
          || resource.data.workerUid == request.auth.uid
        );

      allow create: if isSignedIn()
        && isEmailVerified()
        && isValidId(workerId)
        && isValidWorker(incoming())
        && incoming().id == workerId
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isEmailVerified()
        && isValidId(workerId)
        && isValidWorker(incoming())
        && incoming().id == workerId
        && (!('ownerUid' in existing()) || existing().ownerUid == '' || incoming().ownerUid == existing().ownerUid || isAdmin())
        && (
          ('createdAt' in existing() && existing().createdAt is timestamp && incoming().createdAt == existing().createdAt)
          || ((!('createdAt' in existing()) || !(existing().createdAt is timestamp)) && incoming().createdAt == request.time)
        )
        && incoming().updatedAt == request.time
        && (
          (
            (isAdmin() || ('ownerUid' in existing() && isOwner(existing().ownerUid)))
            && (
              // Action: Update worker metadata, health baseline profile, Fit-to-Work clearance, mount mode, MQ-3 gate, workerUid pairing, or band pairing
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'role', 'bandId', 'baselineHr', 'loadFactor',
                'age', 'conditions', 'restingBp', 'mountMode',
                'daysOnSite', 'dutyZone', 'readiness', 'gaitBalance', 'fitStatus', 'fitReasons',
                'mq3Status', 'mq3MgL', 'mq3CheckedAt',
                'shiftHours', 'shiftStartHr',
                'riskFactor', 'dynamicHrY', 'dynamicHrR',
                'mentalStrainLevel', 'mentalRfBoost', 'mentalAdjustedAt', 'workerUid',
                'condition', 'reasons', 'updatedAt'
              ])
              ||
              // Action: Record latest live band telemetry state
              incoming().diff(existing()).affectedKeys().hasOnly([
                'bandId', 'condition', 'reasons', 'lastReport',
                'lastKeepAliveAt', 'leadOff', 'shiftHours', 'shiftStartHr',
                'fitStatus', 'fitReasons',
                'riskFactor', 'dynamicHrY', 'dynamicHrR', 'updatedAt'
              ])
              ||
              // Action: Update 15s keep-alive heartbeat or mechanical lead-off disconnect state
              incoming().diff(existing()).affectedKeys().hasOnly([
                'lastKeepAliveAt', 'leadOff', 'fitStatus', 'fitReasons',
                'condition', 'reasons', 'updatedAt'
              ])
              ||
              isAdmin()
            )
          )
          ||
          (
            // Action: Paired worker (JaanSaathi) syncs ONLY anonymized mental fitness adjustment (never private text)
            isWorkerSelf(existing())
            && incoming().workerUid == existing().workerUid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'mentalStrainLevel', 'mentalRfBoost', 'mentalAdjustedAt',
              'fitStatus', 'fitReasons',
              'riskFactor', 'dynamicHrY', 'dynamicHrR', 'updatedAt'
            ])
          )
        );

      allow delete: if isSignedIn()
        && isEmailVerified()
        && isValidId(workerId)
        && (isAdmin() || ('ownerUid' in existing() && isOwner(existing().ownerUid)));

      match /telemetry/{reportId} {
        allow get: if isSignedIn()
          && isEmailVerified()
          && isValidId(workerId)
          && isValidId(reportId)
          && (isAdmin() || ('ownerUid' in existing() && isOwner(existing().ownerUid)))
          && exists(/databases/$(database)/documents/workers/$(workerId));

        allow list: if isSignedIn()
          && isEmailVerified()
          && (isAdmin() || resource.data.ownerUid == request.auth.uid);

        allow create: if isSignedIn()
          && isEmailVerified()
          && isValidId(workerId)
          && isValidId(reportId)
          && isValidTelemetryReport(incoming(), workerId)
          && incoming().id == reportId
          && incoming().createdAt == request.time
          && (incoming().ownerUid == request.auth.uid || isAdmin())
          && exists(/databases/$(database)/documents/workers/$(workerId))
          && (
            get(/databases/$(database)/documents/workers/$(workerId)).data.ownerUid == incoming().ownerUid
            || (!('ownerUid' in get(/databases/$(database)/documents/workers/$(workerId)).data) && isAdmin())
          )
          && getAfter(/databases/$(database)/documents/workers/$(workerId)).data.updatedAt == request.time;

        allow update: if false;

        allow delete: if isSignedIn()
          && isEmailVerified()
          && isValidId(workerId)
          && isValidId(reportId)
          && (isAdmin() || ('ownerUid' in existing() && isOwner(existing().ownerUid)));
      }
    }

    // Strict Zero-Leak Private Worker Vault — NEVER readable by managers or admins
    match /worker_private/{workerUid} {
      allow get: if isSignedIn()
        && isEmailVerified()
        && request.auth.uid == workerUid;

      allow list: if false;

      allow create, update: if isSignedIn()
        && isEmailVerified()
        && request.auth.uid == workerUid
        && isValidPrivateVault(incoming(), workerUid)
        && incoming().updatedAt == request.time;

      allow delete: if isSignedIn()
        && isEmailVerified()
        && request.auth.uid == workerUid;

      match /checkins/{checkinId} {
        allow get, list: if isSignedIn()
          && isEmailVerified()
          && request.auth.uid == workerUid;

        allow create: if isSignedIn()
          && isEmailVerified()
          && request.auth.uid == workerUid
          && isValidPrivateCheckin(incoming(), workerUid, checkinId)
          && incoming().createdAt == request.time;

        allow update: if isSignedIn()
          && isEmailVerified()
          && request.auth.uid == workerUid
          && isValidPrivateCheckin(incoming(), workerUid, checkinId)
          && incoming().createdAt == existing().createdAt;

        allow delete: if isSignedIn()
          && isEmailVerified()
          && request.auth.uid == workerUid;
      }
    }
  }
}
